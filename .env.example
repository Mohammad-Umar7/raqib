# Copy to .env and fill in. Never commit .env.
# Claude (Sonnet 5.5 by default): case summaries, generative case-file layout, vision check, browser agent
ANTHROPIC_API_KEY=
RAQIB_MODEL=claude-sonnet-5-5
# Live Google Search, sponsored ads and Google Maps listings (https://serpapi.com)
SERPAPI_KEY=
# auto = real scanner for unknown URLs; live = Claude browser agent drives unknown URLs (needs ANTHROPIC_API_KEY)
RAQIB_MODE=auto
# Use the installed Chrome when Playwright's own Chromium is not installed
RAQIB_BROWSER_CHANNEL=
# Radar: the autonomous loop (certificate logs, new domains, Search/Maps -> sandbox -> inbox).
# Off by default because it opens real suspicious sites in the browser. Set 1 only inside a VM or sandbox.
RAQIB_RADAR=0
RAQIB_RADAR_SCANS_PER_HOUR=120
RAQIB_RADAR_WORKERS=2
# 1 = let Claude write radar case files and check screenshots (costs tokens per scan)
RAQIB_RADAR_AI=0
# Certificate-log tiles read per minute per log (256 certificates, ~0.5 MB each)
RAQIB_CT_TILES_PER_MIN=2
# SerpAPI searches the radar may use per month (free plan: 250)
SERPAPI_MONTHLY_BUDGET=250
